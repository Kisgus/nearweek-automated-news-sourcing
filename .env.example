# Public example only. Do not commit real tokens, account IDs, webhook URLs, or
# channel IDs.

NODE_ENV=development
PORT=3000

# Integration toggles
USE_MCP_BUFFER=false
USE_MCP_TELEGRAM=false
USE_MCP_GITHUB=false
USE_MCP_WEBHOOKS=false

# Optional local routing placeholders
BUFFER_ORG_ID=replace-with-local-value
BUFFER_CHANNEL_ID=replace-with-local-value
ZAPIER_WEBHOOK_BASE=https://example.invalid/webhook

# Analysis/runtime settings
USE_SESSION_CLAUDE=false
CLAUDE_MODEL=replace-with-local-model

# Safety defaults
ENABLE_AUTO_POSTING=false
ENABLE_VIDEO_GENERATION=false
ENABLE_TEAM_NOTIFICATIONS=false
ENABLE_BREAKING_NEWS_ALERTS=false

# Thresholds
CONFIDENCE_THRESHOLD=85
RELEVANCE_THRESHOLD=60
MAX_TWEETS_PER_HOUR=50
RESPONSE_TIME_TARGET=900

# Security/monitoring
WEBHOOK_AUTH_REQUIRED=true
RATE_LIMIT_ENABLED=true
AUDIT_LOGGING_ENABLED=true
HEALTH_CHECK_INTERVAL=300
METRICS_ENABLED=true
ERROR_REPORTING_ENABLED=false
